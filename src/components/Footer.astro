---
import HerzLinie from './HerzLinie.astro';
import { site, telHref, whatsappHref, socials, adresseEinzeilig } from '../lib/site';
const jahr = new Date().getFullYear();
---
<footer class="bg-nova-950 text-nova-100">
  <div class="container-nova grid gap-10 py-14 md:grid-cols-3">
    <div>
      <HerzLinie class="h-14 w-auto text-nova-400" />
      <p class="mt-4 font-display text-xl font-bold text-white">{site.name}</p>
      <p class="font-display text-nova-100">{site.untertitel}</p>
    </div>
    <div>
      <h2 class="font-display text-base font-bold !text-white">Kontakt</h2>
      <address class="mt-3 not-italic leading-relaxed">
        {adresseEinzeilig}<br />
        <a href={telHref} class="text-nova-100 hover:text-white">{site.telefon.anzeige}</a>
        {' · '}<a href={whatsappHref} target="_blank" rel="noopener" class="text-nova-100 hover:text-white">WhatsApp</a>
        {site.email && <><br /><a href={`mailto:${site.email}`} class="text-nova-100 hover:text-white">{site.email}</a></>}
      </address>
      {socials.length > 0 && (
        <ul class="mt-3 flex gap-4">
          {socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener" class="text-nova-100 hover:text-white">{s.name}</a></li>)}
        </ul>
      )}
    </div>
    <div>
      <h2 class="font-display text-base font-bold !text-white">Rechtliches</h2>
      <ul class="mt-3 space-y-1">
        <li><a href="/impressum" class="text-nova-100 hover:text-white">Impressum</a></li>
        <li><a href="/datenschutz" class="text-nova-100 hover:text-white">Datenschutz</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="container-nova flex flex-col gap-2 py-5 text-sm sm:flex-row sm:justify-between">
      <p>© {jahr} {site.name}, {site.inhaberin}</p>
      <p>Gestaltung: <a href={site.gestaltung.url} class="text-nova-100 hover:text-white">{site.gestaltung.name}</a></p>
    </div>
  </div>
</footer>
