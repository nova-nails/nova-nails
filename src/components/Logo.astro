---
import HerzLinie from './HerzLinie.astro';
import { site } from '../lib/site';
// Logo überall Akzent; nur auf Akzent-Flächen (Footer) Hell
interface Props { size?: 'sm' | 'lg'; as?: 'div' | 'h1'; tone?: 'akzent' | 'hell' }
const { size = 'sm', as: Tag = 'div', tone = 'akzent' } = Astro.props;
const farbe = tone === 'hell' ? 'text-hell' : 'text-akzent';
---
{size === 'sm' ? (
  <span class={`flex items-center gap-1.5 sm:gap-2.5 ${farbe}`}>
    <HerzLinie class="h-7 w-auto sm:h-9" />
    <span class="whitespace-nowrap font-display text-[0.95rem] font-bold leading-none sm:text-lg">{site.name}</span>
  </span>
) : (
  <Tag class={`flex flex-col items-center text-center ${farbe}`}>
    <HerzLinie class="h-auto w-44 sm:w-56" />
    <span class="mt-5 block font-display text-5xl font-bold leading-none sm:text-6xl">{site.name}</span>
    <span class="mt-3 block font-display text-lg font-normal">{site.untertitel}</span>
  </Tag>
)}
