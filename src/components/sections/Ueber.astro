---
import { Image } from 'astro:assets';
import ueber from '../../../content/ueber.json';
import julia from '../../assets/julia/julia-tellenbach.png';
import HerzLinie from '../HerzLinie.astro';
---
<section id="ueber-mich" class="bg-nova-200 py-16 sm:py-24" aria-labelledby="ueber-titel">
  <div class="container-nova grid items-start gap-12 md:grid-cols-[0.8fr_1.2fr]">
    <div class="flex justify-center md:sticky md:top-28">
      <!-- [TODO: Originalfoto in voller Auflösung bei der Inhaberin anfragen] -->
      <Image
        src={julia}
        alt={ueber.bildAlt}
        widths={[280, 444]}
        sizes="(min-width: 768px) 300px, 280px"
        class="sticker h-auto w-[280px] md:w-[300px]"
        loading="lazy"
      />
    </div>
    <div>
      <p class="eyebrow">Julia Tellenbach</p>
      <h2 id="ueber-titel" class="mt-2 text-3xl font-bold sm:text-4xl">{ueber.titel}</h2>
      <div class="mt-6 space-y-4 text-lg">
        {ueber.absaetze.map((a, i) => (
          <p>
            {a}
            {i === ueber.absaetze.length - 1 && <HerzLinie class="ml-1 inline-block h-6 w-auto align-[-0.3em] text-nova-800" />}
          </p>
        ))}
      </div>
      <ul class="mt-10 grid gap-4">
        {ueber.fakten.map((f) => (
          <li class="rounded-[var(--radius-card)] bg-white p-5">
            <h3 class="text-base font-bold">{f.titel}</h3>
            <p class="mt-1 text-[0.95rem] text-muted">{f.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .sticker { transform: rotate(-3deg); filter: drop-shadow(0 6px 14px rgb(61 31 40 / 0.12)); }
  @media (prefers-reduced-motion: no-preference) {
    .sticker { transition: transform .4s ease; }
    .sticker:hover { transform: rotate(0deg); }
  }
</style>
