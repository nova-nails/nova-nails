---
import faq from '../../../content/faq.json';
import SectionHead from '../SectionHead.astro';
---
<section id="gut-zu-wissen" class="bg-hell py-16 sm:py-24" aria-labelledby="wissen-titel">
  <div class="container-nova">
    <SectionHead id="wissen-titel" eyebrow="Regeln & Infos" titel={faq.titel} farbe="text-akzent" />
    <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {faq.punkte.map((p) => (
        <div class="border-t-2 border-zart pt-4">
          <dt class="font-display text-lg font-bold text-zart">{p.titel}</dt>
          <dd class="mt-2 text-akzent">{p.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
