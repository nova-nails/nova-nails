---
import SectionHead from '../SectionHead.astro';
import BookingButton from '../BookingButton.astro';
import { site, telHref, whatsappHref, mapsGoogle, mapsApple, socials } from '../../lib/site';
---
<section id="anfahrt" class="bg-nova-200 py-16 sm:py-24" aria-labelledby="anfahrt-titel">
  <div class="container-nova">
    <SectionHead id="anfahrt-titel" eyebrow="Anfahrt & Termine" titel="So findest du mich" />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <div class="card p-6">
        <h3 class="text-xl font-bold">Adresse</h3>
        <address class="mt-3 not-italic">
          {site.name}<br />{site.adresse.strasse}<br />{site.adresse.plz} {site.adresse.ort}
        </address>
        <ul class="mt-4 space-y-1 text-[0.98rem]">
          {site.anreise.map((a) => <li>{a}</li>)}
        </ul>
        <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
          <a href={mapsGoogle} target="_blank" rel="noopener">Google Maps<span class="sr-only"> (neuer Tab)</span></a>
          <a href={mapsApple} target="_blank" rel="noopener">Apple Karten<span class="sr-only"> (neuer Tab)</span></a>
        </p>
      </div>
      <div class="card p-6">
        <h3 class="text-xl font-bold">Termine</h3>
        <p class="mt-3">{site.zeiten.text}</p>
        <p class="text-muted">{site.zeiten.hinweis}</p>
        <BookingButton class="mt-6" />
      </div>
      <div class="card p-6">
        <h3 class="text-xl font-bold">Kontakt</h3>
        <ul class="mt-3 space-y-1">
          <li>Telefon: <a href={telHref}>{site.telefon.anzeige}</a></li>
          <li><a href={whatsappHref} target="_blank" rel="noopener">WhatsApp schreiben<span class="sr-only"> (neuer Tab)</span></a></li>
          {site.email && <li>E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a></li>}
          {socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.name}<span class="sr-only"> (neuer Tab)</span></a></li>)}
        </ul>
        <p class="mt-4 text-muted">{site.antwortzeit}</p>
      </div>
    </div>
  </div>
</section>
