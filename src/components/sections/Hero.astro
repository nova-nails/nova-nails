---
import HerzLinie from '../HerzLinie.astro';
import BookingButton from '../BookingButton.astro';
import { site, telHref } from '../../lib/site';
---
<section class="relative overflow-hidden bg-nova-200" aria-labelledby="hero-titel">
  <div class="container-nova grid items-center gap-10 py-14 sm:py-20 md:grid-cols-[1.1fr_0.9fr] md:py-24">
    <div class="order-2 md:order-1">
      {site.schalter.showOpeningBanner && (
        <p class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 font-display text-sm font-bold text-nova-800">
          <span class="h-2 w-2 rounded-full bg-signal" aria-hidden="true"></span>
          Eröffnung {site.eroeffnung}
        </p>
      )}
      <h1 id="hero-titel" class="mt-6">
        <span class="block text-5xl font-bold sm:text-6xl lg:text-7xl">{site.name}</span>
        <span class="mt-2 block font-display text-xl font-normal text-nova-900 sm:text-2xl">{site.untertitel}</span>
      </h1>
      <p class="mt-6 font-display text-2xl font-bold text-nova-950 sm:text-3xl">{site.hero.titel}</p>
      <p class="mt-4 max-w-lg text-lg">{site.hero.text}</p>
      <p class="mt-3 flex items-center gap-2 font-medium text-nova-950">
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-nova-800" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        {site.adresse.ort} {site.adresse.kanton}, {site.adresse.region}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <BookingButton />
        <a href={telHref} class="btn btn-secondary">Anrufen<span class="sr-only"> {site.telefon.anzeige}</span></a>
      </div>
    </div>
    <div class="order-1 flex justify-center md:order-2">
      <HerzLinie class="h-auto w-56 text-signal sm:w-72 md:w-full md:max-w-md" />
    </div>
  </div>
</section>
