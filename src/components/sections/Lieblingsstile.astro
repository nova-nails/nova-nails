---
import daten from '../../../content/lieblingsstile.json';
import SectionHead from '../SectionHead.astro';
const stern = (x: number, y: number, r: number) =>
  `M${x} ${y - r}C${x} ${y - r / 4} ${x + r / 4} ${y} ${x + r} ${y}C${x + r / 4} ${y} ${x} ${y + r / 4} ${x} ${y + r}C${x} ${y + r / 4} ${x - r / 4} ${y} ${x - r} ${y}C${x - r / 4} ${y} ${x} ${y - r / 4} ${x} ${y - r}Z`;
const nagel = 'M32 118V52C32 22 46 8 60 8s28 14 28 44v66';
const bett = 'M42 118V62c0-16 8-26 18-26s18 10 18 26v56';
---
<section class="bg-nova-50 py-16 sm:py-24" aria-labelledby="stile-titel">
  <div class="container-nova grid items-center gap-10 md:grid-cols-2">
    <SectionHead id="stile-titel" eyebrow="Lieblingsstile" titel={daten.titel}>
      <p class="mt-4 text-lg">{daten.text}</p>
    </SectionHead>
    <ul class="grid grid-cols-2 gap-5">
      {daten.stile.map((s, i) => (
        <li class="card flex flex-col items-center p-6 text-center">
          <svg viewBox="0 0 120 124" class="h-28 w-auto text-signal" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d={nagel} />
            <path d={bett} />
            {i === 0 ? (
              <path d="M43 50c5-9 11-13 17-13s12 4 17 13" />
            ) : (
              <>
                <path d={stern(60, 60, 9)} fill="currentColor" stroke="none" />
                <path d={stern(52, 84, 5)} fill="currentColor" stroke="none" />
                <path d={stern(68, 96, 6)} fill="currentColor" stroke="none" />
                <path d={stern(100, 26, 8)} fill="currentColor" stroke="none" />
                <path d={stern(14, 40, 6)} fill="currentColor" stroke="none" />
              </>
            )}
          </svg>
          <h3 class="mt-4 text-2xl font-bold">{s.name}</h3>
          <p class="mt-1 text-muted">{s.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
