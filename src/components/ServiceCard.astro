---
import { chf } from '../lib/site';
interface Props {
  name: string;
  beschreibung: string;
  dauer: string | null;
  preisVon: number | null;
  preisBis?: number | null;
  preisLabel?: string;
}
const { name, beschreibung, dauer, preisVon, preisBis = null, preisLabel } = Astro.props;
---
<li class="card flex flex-col border-2 border-akzent p-6">
  <h3 class="text-xl font-bold text-akzent">{name}</h3>
  <p class="mt-2 flex-1 text-[0.98rem] text-zart">{beschreibung}</p>
  <dl class="mt-5 flex items-end justify-between gap-4 border-t border-zart pt-4">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-zart">Dauer</dt>
      <dd class="whitespace-nowrap font-display font-bold text-akzent">{dauer ?? 'folgt'}</dd>
    </div>
    <div class="text-right">
      <dt class="text-xs font-semibold uppercase tracking-wider text-zart">{preisLabel ?? 'Preis'}</dt>
      <dd class="whitespace-nowrap font-display text-lg font-bold text-akzent">{preisVon != null ? chf(preisVon, preisBis) : 'folgt'}</dd>
    </div>
  </dl>
</li>
