---
import { chf } from '../lib/site';
interface Props {
  name: string;
  beschreibung: string;
  dauer: string | null;
  preis: number | null;
  preisLabel?: string;
}
const { name, beschreibung, dauer, preis, preisLabel } = Astro.props;
---
<li class="card flex flex-col p-6">
  <h3 class="text-xl font-bold">{name}</h3>
  <p class="mt-2 flex-1 text-[0.98rem] text-muted">{beschreibung}</p>
  <dl class="mt-5 flex items-end justify-between gap-4 border-t border-nova-200 pt-4">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Dauer</dt>
      <dd class="font-display font-bold">{dauer ?? 'folgt'}</dd>
    </div>
    <div class="text-right">
      <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{preisLabel ?? 'Preis'}</dt>
      <dd class="font-display text-lg font-bold text-nova-800">{preis != null ? chf(preis) : 'folgt'}</dd>
    </div>
  </dl>
</li>
