---
import { chf } from '../lib/site';
import PeText from '../../peter-und-co-editor/astro/PeText.astro';
import { peFuer, peAktiv } from '../../peter-und-co-editor/astro/pe';
interface Props {
  name: string;
  beschreibung: string;
  dauer: string | null;
  preisVon: number | null;
  preisBis?: number | null;
  preisLabel?: string;
  buchenHref?: string | null;
  /** Bearbeiten-Modus: Eintrag in preise.json, z. B. «preise.json#leistungen.0» */
  peBasis?: string;
}
const { name, beschreibung, dauer, preisVon, preisBis = null, preisLabel, buchenHref = null, peBasis } = Astro.props;
const pe = peFuer(Astro.url);
const peFeld = (f: string) => (peBasis ? `${peBasis}.${f}` : null);
const preisEinzeln = peBasis && peAktiv(Astro.url) && preisVon != null;
---
<li class="card flex flex-col border-2 border-akzent p-6">
  <h3 class="text-xl font-bold text-akzent" data-pe={pe(peFeld('name'))}>{name}</h3>
  <p class="mt-2 flex-1 text-[0.98rem] text-zart" data-pe={pe(peFeld('beschreibung'))}>{beschreibung}</p>
  <dl class="mt-5 flex items-end justify-between gap-4 border-t border-zart pt-4">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wider text-zart">Dauer</dt>
      <dd class="whitespace-nowrap font-display font-bold text-akzent" data-pe={pe(dauer != null ? peFeld('dauer') : null)}>{dauer ?? 'folgt'}</dd>
    </div>
    <div class="text-right">
      <dt class="text-xs font-semibold uppercase tracking-wider text-zart">{preisLabel ?? 'Preis'}</dt>
      <dd class="whitespace-nowrap font-display text-lg font-bold text-akzent">{preisEinzeln ? <>CHF <PeText f={`${peBasis}.preisVon`} v={preisVon} />{preisBis != null && <>–<PeText f={`${peBasis}.preisBis`} v={preisBis} /></>}</> : preisVon != null ? chf(preisVon, preisBis) : 'folgt'}</dd>
    </div>
  </dl>
  {buchenHref && (
    <a href={buchenHref} target="_blank" rel="noopener" class="mt-4 self-start font-display font-bold text-akzent hover:text-akzent">
      Diese Leistung buchen<span class="sr-only"> ({name}, Online-Buchung, öffnet in neuem Tab)</span>
    </a>
  )}
</li>
