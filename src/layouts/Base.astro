---
import '../styles/global.css';
import comfortaa from '@fontsource-variable/comfortaa/files/comfortaa-latin-wght-normal.woff2?url';
import figtree from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, pagePath } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  schema?: object;
  minimalHeader?: boolean;
}
const standardBeschreibung = site.schalter.showOpeningBanner
  ? `${site.seo.beschreibung} Eröffnung ${site.eroeffnung}.`
  : site.seo.beschreibung;
const { title, description = standardBeschreibung, noindex = false, schema, minimalHeader = false } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : site.seo.titel;
const path = pagePath(Astro.url.pathname);
const canonical = new URL(path, Astro.site).href.replace(/\/$/, '');
const ogImage = new URL('/og.png', Astro.site).href;

// Nur latin (Learning 2026-10-21: Display- und Textschrift preloaden → CLS 0)
const fontFaces = `
@font-face{font-family:'Comfortaa Variable';font-style:normal;font-display:swap;font-weight:300 700;src:url(${comfortaa}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Figtree Variable';font-style:normal;font-display:swap;font-weight:300 900;src:url(${figtree}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f3cfce" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={comfortaa} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtree} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo Nova Nails by Julia Tellenbach" />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-dvh">
    <a href="#inhalt" class="sr-only z-50 rounded-full bg-nova-800 px-5 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Zum Inhalt springen</a>
    <Header minimal={minimalHeader} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
