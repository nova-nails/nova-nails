---
import Base from '../layouts/Base.astro';
import HerzLinie from '../components/HerzLinie.astro';
import BookingButton from '../components/BookingButton.astro';
---
<Base title="Seite nicht gefunden" noindex>
  <section class="bg-nova-200">
    <div class="container-nova flex flex-col items-center py-20 text-center sm:py-28">
      <HerzLinie class="h-auto w-40 text-akzent" />
      <p class="eyebrow mt-8">Fehler 404</p>
      <h1 class="mt-2 text-4xl font-bold sm:text-5xl">Diese Seite gibt es nicht</h1>
      <p class="mt-4 max-w-md text-lg">Vielleicht hat sich die Adresse geändert. Auf der Startseite findest du alles zu Nova Nails.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-secondary">Zur Startseite</a>
        <BookingButton />
      </div>
    </div>
  </section>
</Base>
